{
  "id": "radix",
  "name": "Radix Themes",
  "what": "React components with a real theming API — but one that takes CHOICES, not values",
  "layer": "components",
  "standalone": true,
  "plain": null,
  "choices": {
    "brand": {
      "attr": "data-accent-color",
      "unit": "colour",
      "of": {
        "amber": "#ffc53d",
        "blue": "#0090ff",
        "bronze": "#a18072",
        "brown": "#ad7f58",
        "crimson": "#e93d82",
        "cyan": "#00a2c7",
        "gold": "#978365",
        "grass": "#46a758",
        "gray": "#8d8d8d",
        "green": "#30a46c",
        "indigo": "#3e63dd",
        "iris": "#5b5bd6",
        "jade": "#29a383",
        "lime": "#bdee63",
        "mauve": "#8e8c99",
        "mint": "#86ead4",
        "olive": "#898e87",
        "orange": "#f76b15",
        "pink": "#d6409f",
        "plum": "#ab4aba",
        "purple": "#8e4ec6",
        "red": "#e5484d",
        "ruby": "#e54666",
        "sage": "#868e8b",
        "sand": "#8d8d86",
        "sky": "#7ce2fe",
        "slate": "#8b8d98",
        "teal": "#12a594",
        "tomato": "#e54d2e",
        "violet": "#6e56cf",
        "yellow": "#ffe629"
      },
      "why": "Radix has no brand variable. Its accent is one of these hand-built twelve-step scales, chosen on the Theme root"
    },
    "ink": {
      "attr": "data-gray-color",
      "unit": "colour",
      "of": {
        "mauve": "#211f26",
        "olive": "#1d211c",
        "sage": "#1a211e",
        "sand": "#21201c",
        "slate": "#1c2024"
      },
      "why": "Radix's greys are a chosen twelve-step scale too, and step 12 is the text colour"
    },
    "radius": {
      "attr": "data-radius",
      "unit": "px",
      "base": 4,
      "of": {
        "none": "0px",
        "small": "3px",
        "medium": "4px",
        "large": "6px",
        "full": "9999px"
      },
      "why": "every --radius-N is calc(Npx * --scaling * --radius-factor); the factor comes from one of these five settings"
    },
    "baseText": {
      "attr": "data-scaling",
      "unit": "px",
      "base": 16,
      "of": {
        "90%": "14.4px",
        "95%": "15.2px",
        "100%": "16px",
        "105%": "16.8px",
        "110%": "17.6px"
      },
      "why": "Radix scales the whole type and space ramp together, in five steps"
    }
  },
