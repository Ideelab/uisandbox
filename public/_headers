# Cloudflare Pages / Netlify headers.
#
# The service worker must never be stale: a cached sw.js is a cached sandbox.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Hashed assets are immutable by name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app itself, and everything else: sensible defaults. No CSP script-src
# yet — the sandbox needs Google Fonts, blob: fonts and CORS zip fetches, and a
# policy is measured against the hold-outs before it is set (notes/roadmap.md).
# HSTS: a year, and every subdomain. The Worker already redirects http and
# every *.uisandbox.org to the apex over https, so this only tells the browser
# to stop asking. `preload` is deliberately NOT set: joining the preload list
# is easy and leaving it takes months, so it is a decision to make on purpose
# rather than a line inherited from a header file.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN

# Text files for crawlers and models, and the images cards use.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/og.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Content-Type: application/manifest+json

# Sample builds: real open-source builds (MIT), a day of cache is plenty.
/samples/*
  Cache-Control: public, max-age=86400

# The bridge, loaded by OTHER people's apps through one script line. It must
# never be stale against the page half it talks to: an old copy does not know
# uicockpit:read, and the door says "Its live.js may be an old copy". So it is
# revalidated on every load, the same reasoning as sw.js. No CORP header is set
# anywhere, which is what lets another origin load it at all.
/live.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache

# The kit door's builds: made from each kit's own package, a day of cache.
/kits/*
  Cache-Control: public, max-age=86400
