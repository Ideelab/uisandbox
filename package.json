{
  "name": "uisandbox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test src/audit/__tests__/*.test.mjs && pnpm test:kits",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "holdouts": "node scripts/holdouts.mjs",
    "mcp": "tsx mcp/server.ts",
    "mcp:build": "pnpm build && vite build --config mcp/vite.config.ts && rm -rf mcp/dist/app && cp -R dist mcp/dist/app && rm -f mcp/dist/app/_headers && rm -rf mcp/dist/app/samples",
    "mcp:pack": "pnpm mcp:build && cd mcp && npm pack",
    "test:kits": "cd src/kits/engine && node --test *.test.mjs",
    "kits:build": "node scripts/kit-builds.mjs",
    "kits:fidelity": "cd src/kits/engine && node fidelity.mjs",
    "knobs:looks": "node scripts/knob-looks.mjs",
    "live:dev": "pnpm mcp:build && node scripts/live-dev.mjs",
    "kits:gates": "node scripts/kit-detect.mjs && node scripts/kit-export.mjs && node scripts/live-bridge.mjs",
    "kits:live": "node scripts/live-build.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
